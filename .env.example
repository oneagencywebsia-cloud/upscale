# ============ Upscale — variables de entorno ============
# Copia a apps/api/.env  y  apps/web/.env.local  y rellena. NO commitear.

# ---------- API (apps/api/.env) ----------
PORT=8080

# Postgres de Supabase (pooler, puerto 5432).
DATABASE_URL=

# Supabase → Settings → API → "JWT Secret". La API verifica con esto los tokens de sesión.
SUPABASE_JWT_SECRET=

# Origen(es) del frontend para CORS. En prod: https://upscale.tudominio.es
WEB_ORIGIN=http://localhost:3001

# ---------- Cloudflare R2 ----------
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=upscale
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------- Binarios (dejar así si están en el PATH) ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TMP_DIR=./tmp


# ---------- WEB (apps/web/.env.local) ----------
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la API de Upscale
UPSCALE_API_URL=http://localhost:8080
