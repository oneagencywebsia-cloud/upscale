# ============ Upscale — variables de entorno ============
# Copia a apps/api/.env  y  apps/web/.env.local  y rellena. NO commitear.

# ---------- API (apps/api/.env) ----------
PORT=8080

# Postgres de Supabase (pooler, puerto 5432).
DATABASE_URL=

# Supabase → Settings → API → "JWT Secret".
SUPABASE_JWT_SECRET=

# Origen(es) del frontend para CORS. En prod: la URL de la web.
WEB_ORIGIN=http://localhost:3001

# --- Dónde se guardan los archivos ---
# telegram = canal privado de Telegram (coste 0, no tu PC ni tu VPS) — POR DEFECTO
# local    = disco de esta máquina
# r2       = Cloudflare R2 (de pago)
STORAGE_DRIVER=telegram

# URL pública de ESTA API (para los enlaces de miniatura/descarga). Ej: https://api.upscale.tudominio.es
PUBLIC_API_URL=http://localhost:8080
# Secreto para firmar los enlaces temporales (openssl rand -hex 32). Si vacío usa SUPABASE_JWT_SECRET.
BLOB_SECRET=

# --- Solo STORAGE_DRIVER=telegram ---
# De https://my.telegram.org (API development tools):
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Se genera con:  pnpm --filter @upscale/api tg-login
TELEGRAM_SESSION=
# Id del canal/grupo privado que hará de almacén (lo imprime tg-login). Ej: -1001234567890
TELEGRAM_CHANNEL_ID=
TG_CACHE_DIR=./tg-cache
TG_CACHE_MAX_MB=2048

# --- Solo STORAGE_DRIVER=local ---
STORAGE_DIR=./data

# --- Solo STORAGE_DRIVER=r2 ---
R2_ENDPOINT=
R2_BUCKET=upscale
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------- Binarios (dejar así si están en el PATH) ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TMP_DIR=./tmp


# ---------- WEB (apps/web/.env.local) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
UPSCALE_API_URL=http://localhost:8080
