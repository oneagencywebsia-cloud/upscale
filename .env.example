# ============ Upscale — variables de entorno ============
# Copia a apps/api/.env  y  apps/web/.env.local  y rellena. NO commitear.

# ---------- API (apps/api/.env) ----------
PORT=8080

# Postgres de Supabase (pooler, puerto 5432).
DATABASE_URL=

# Supabase → Settings → API → "JWT Secret".
SUPABASE_JWT_SECRET=

# Origen(es) del frontend para CORS. En prod: la URL de Vercel, p.ej. https://upscale.vercel.app
WEB_ORIGIN=http://localhost:3001

# --- Dónde se guardan los archivos ---
# "local" = disco de ESTA máquina (coste 0, recomendado). "r2" = Cloudflare R2 (de pago).
STORAGE_DRIVER=local
# Carpeta donde se guardan (modo local). Absoluta o relativa a apps/api.
STORAGE_DIR=./data
# URL pública de ESTA API (para los enlaces de descarga/miniatura). Ej: https://carri-pc.tailXXXX.ts.net
PUBLIC_API_URL=http://localhost:8080
# Secreto para firmar los enlaces temporales (openssl rand -hex 32). Si se deja vacío usa SUPABASE_JWT_SECRET.
BLOB_SECRET=

# --- Solo si STORAGE_DRIVER=r2 ---
R2_ENDPOINT=
R2_BUCKET=upscale
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------- Binarios (dejar así si están en el PATH) ----------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TMP_DIR=./tmp


# ---------- WEB (apps/web/.env.local) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la API (la misma que PUBLIC_API_URL de arriba)
UPSCALE_API_URL=http://localhost:8080
