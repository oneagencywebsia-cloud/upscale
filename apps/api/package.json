{
  "name": "@upscale/api",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "serve": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "tg-login": "tsx --env-file-if-exists=.env src/tg-login.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.678.0",
    "@aws-sdk/s3-request-presigner": "^3.678.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@upscale/shared": "workspace:*",
    "fastify": "^5.1.0",
    "input": "^1.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "telegram": "^2.26.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
